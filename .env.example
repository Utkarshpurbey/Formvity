# Copy once:  cp .env.example .env
#
# npm run dev        → hot reload + Render API (config/render.env)
# npm run dev:local  → hot reload + local Spring :8081 (config/local.env)
# npm run preview    → production build + start (no hot reload)
#
# `.env.local` can hold secrets; it must not set NEXT_PUBLIC_API_* or it will
# fight the dev scripts. Use the npm scripts above to pick the API target.

NEXT_PUBLIC_API_URL=https://api-formvity.onrender.com
NEXT_PUBLIC_API_DIRECT=true
API_PROXY_TARGET=https://api-formvity.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
