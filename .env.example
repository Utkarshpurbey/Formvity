# Copy to .env.local for overrides (optional — .env.local overrides .env in Next.js).

# Deployed backend (local dev + Pages use the same URL)
NEXT_PUBLIC_API_URL=https://formvity-backend.onrender.com
NEXT_PUBLIC_API_DIRECT=true
API_PROXY_TARGET=https://formvity-backend.onrender.com

# GitHub Pages (set in CI; empty base path for username.github.io repos)
# NEXT_PUBLIC_APP_URL=https://your-user.github.io
# NEXT_PUBLIC_BASE_PATH=/Form-Builder-UI
# NEXT_PUBLIC_API_DIRECT=false
# NEXT_PUBLIC_API_URL=http://localhost:8081
# API_PROXY_TARGET=http://localhost:8081
